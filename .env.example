# C03 Synthetic Microservices Lab — Environment Template (Synthetic Only)
# Do NOT commit real secrets or production credentials (NFR-017 / RULE-001).

SIM_ENVIRONMENT=lab
SIM_APPLICATION=sre-simulation-poc
BUILD_VERSION=0.1.0-sim
OWNER_REF=project-initiator-michael

# Local host binding for API Gateway (bound strictly to 127.0.0.1)
GATEWAY_HOST_PORT=18080

# Synthetic PostgreSQL Ledger Store (internal Docker network only)
POSTGRES_USER=sre_sim
POSTGRES_PASSWORD=sre_sim_synth_pass_local
POSTGRES_DB=sre_sim_ledger
DATABASE_URL=postgresql://sre_sim:sre_sim_synth_pass_local@postgres:5432/sre_sim_ledger

# Synthetic RabbitMQ Event Broker (internal Docker network only)
RABBITMQ_DEFAULT_USER=sre_sim
RABBITMQ_DEFAULT_PASS=sre_sim_synth_pass_local
RABBITMQ_URL=amqp://sre_sim:sre_sim_synth_pass_local@rabbitmq:5672/%2F
RABBITMQ_QUEUE=notifications.transaction.completed
RABBITMQ_DLQ=notifications.transaction.dlq
RABBITMQ_ENABLED=true

# Deterministic Traffic Generator Defaults
TRAFFIC_SEED=20261109
TRAFFIC_PROFILE=normal

# C04 Fault Harness & Restricted Ground Truth Isolation (Synthetic Operator Keys Only)
HARNESS_CONTROL_TOKEN=SYNTH-HARNESS-CTRL-KEY-C04
EVALUATOR_CONTROL_TOKEN=SYNTH-EVALUATOR-KEY-C04
RESTRICTED_EVAL_ROOT=./restricted/gt_registry

# C05 Telemetry & Service Catalog Backends (Bound strictly to 127.0.0.1)
OTEL_COLLECTOR_URL=http://otel-collector:4318
OTEL_EXPORT_ENABLED=true
OTEL_HOST_PORT=14318
PROMETHEUS_HOST_PORT=19090
LOKI_HOST_PORT=13100
TEMPO_HOST_PORT=13200
GRAFANA_HOST_PORT=13000
ALERT_WEBHOOK_TOKEN=SYNTH-ALERT-WEBHOOK-KEY-C05


# C13: explicit --live only; pytest never reads this credential.
# Approved endpoint/model and limits are pinned in orchestrator/llm_provider.py.
OPENROUTER_API_KEY=

# C19 Tahap 1A: outbound-only Telegram notification and local review console.
# Leave both Telegram values empty to keep the dispatcher in dry-run mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SRE_STATE_DB=orchestrator_state.db
SRE_REVIEWER_REF=sre_reviewer
SRE_REVIEWER_ROLE=L2_SRE
SRE_REVIEW_AUDIT_LOG=artifacts/audit/c19-review-audit.jsonl
SRE_HANDOVER_ROOT=artifacts/handover
C15_USAGE_METRICS_PATH=artifacts/observability/usage-cost-metrics.json
