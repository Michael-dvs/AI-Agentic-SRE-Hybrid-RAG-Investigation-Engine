{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-sim:contract:retrieval-result:1",
  "title": "Authorized Knowledge Retrieval Result Contract v1",
  "description": "Bounded, versioned retrieval response envelope shared across lexical, dense, hybrid, and reranked modes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "retrieval_mode_executed",
    "index_version",
    "observed_at",
    "applied_filters",
    "citations",
    "truncated",
    "context_tokens_used",
    "latency_ms",
    "gap_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": ["ok", "no_match", "unavailable", "rejected"]
    },
    "retrieval_mode_executed": {
      "type": "string",
      "enum": ["lexical_only", "dense_only", "hybrid_rrf", "hybrid_rerank"]
    },
    "index_version": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 64
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "applied_filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "environment",
        "reference_time",
        "status_required",
        "caller_scope_ref"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "environment": {
          "type": "string",
          "enum": ["lab", "sim-staging", "sim-prod-like"]
        },
        "reference_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "status_required": {
          "const": "approved"
        },
        "caller_scope_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "document_id",
          "document_version",
          "title",
          "section_path",
          "source_uri",
          "service_id",
          "environment",
          "status",
          "effective_from",
          "effective_to",
          "content_hash",
          "score",
          "score_type",
          "source_branch",
          "sanitized_excerpt",
          "applicability_verified"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "minLength": 4,
            "maxLength": 128
          },
          "document_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          },
          "document_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "section_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_uri": {
            "type": "string",
            "pattern": "^kb://[A-Za-z0-9._/-]+$"
          },
          "service_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "environment": {
            "type": "string",
            "enum": ["lab", "sim-staging", "sim-prod-like"]
          },
          "status": {
            "const": "approved"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "effective_to": {
            "type": ["string", "null"],
            "format": "date-time",
            "pattern": "Z$"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "score": {
            "type": "number"
          },
          "score_type": {
            "type": "string",
            "enum": ["bm25_sparse", "cosine_dense", "rrf_fusion", "cross_encoder_rerank"]
          },
          "source_branch": {
            "type": "string",
            "enum": ["sparse", "dense", "hybrid", "reranked"]
          },
          "sanitized_excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "applicability_verified": {
            "const": true
          }
        }
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "context_tokens_used": {
      "type": "integer",
      "minimum": 0
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "gap_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "NO_APPLICABLE_RUNBOOK",
        "RETRIEVAL_UNAVAILABLE",
        "FORBIDDEN_SCOPE",
        "SCHEMA_INVALID",
        "BUDGET_EXHAUSTED"
      ]
    }
  }
}

