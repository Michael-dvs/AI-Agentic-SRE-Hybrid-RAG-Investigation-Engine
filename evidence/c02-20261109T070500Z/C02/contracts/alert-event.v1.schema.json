{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-sim:contract:alert-event:1",
  "title": "Alert Intake Event Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alert_id",
    "source_id",
    "service_id",
    "environment",
    "alert_type",
    "severity",
    "event_time",
    "window_start",
    "window_end",
    "build_version",
    "error_code",
    "trace_id",
    "summary",
    "source_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "alert_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:-]{4,128}$"
    },
    "source_id": {
      "type": "string",
      "enum": ["src-prom-metrics", "src-loki-logs", "src-sim-services"]
    },
    "service_id": {
      "type": "string",
      "enum": [
        "api-gateway",
        "auth-service",
        "transaction-service",
        "ledger-service",
        "notification-service",
        "db-dummy",
        "svc-a",
        "svc-b",
        "svc-c"
      ]
    },
    "environment": {
      "type": "string",
      "enum": ["lab", "staging-sim", "prod-sim"]
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "high_error_rate",
        "high_latency_p95",
        "dependency_unavailable",
        "connection_pool_exhausted",
        "auth_failure_spike",
        "queue_consumer_lag"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "window_end": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "build_version": {
      "type": ["string", "null"],
      "maxLength": 64
    },
    "error_code": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "trace_id": {
      "type": ["string", "null"],
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}

