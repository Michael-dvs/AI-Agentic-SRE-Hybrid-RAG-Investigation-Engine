{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-sim:contract:knowledge-chunk:1",
  "title": "Knowledge Base Chunk Contract v1",
  "description": "Canonical metadata and content schema for synthetic SOP/runbook chunks indexed in Qdrant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chunk_id",
    "document_id",
    "document_version",
    "index_version",
    "title",
    "source_uri",
    "section_path",
    "service_id",
    "service.name",
    "environment",
    "application",
    "component",
    "status",
    "effective_from",
    "effective_to",
    "content_hash",
    "classification",
    "allowed_groups",
    "owner_ref",
    "language",
    "content",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "chunk_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "document_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "document_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "index_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "source_uri": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^kb://[A-Za-z0-9._/-]+$"
    },
    "section_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "service.name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environment": {
      "type": "string",
      "enum": ["lab", "sim-staging", "sim-prod-like"]
    },
    "application": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": ["approved", "draft", "obsolete", "withdrawn"]
    },
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "effective_to": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "Z$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "classification": {
      "type": "string",
      "enum": ["synthetic-internal", "synthetic-restricted", "synthetic-confidential"]
    },
    "allowed_groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "language": {
      "type": "string",
      "enum": ["id", "en", "id-en"]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}

