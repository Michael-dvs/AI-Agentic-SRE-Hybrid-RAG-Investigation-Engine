{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-sim:contract:dossier:1",
  "title": "Incident Investigation Handover Dossier Contract v1",
  "description": "Authoritative structured dossier schema binding evidence, hypotheses, contradictions, SOP citations, human review, and version provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_id",
    "dossier_version",
    "dossier_hash",
    "severity",
    "service_id",
    "environment",
    "alert_received_at",
    "window_start",
    "window_end",
    "dossier_ready_at",
    "investigation_mode",
    "impact_summary",
    "timeline",
    "evidence",
    "missing_sources",
    "hypotheses",
    "sop_citations",
    "unknowns",
    "recommended_checks",
    "review_summary",
    "reproducibility"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "incident_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128,
      "pattern": "^inc-[a-z0-9-]+$"
    },
    "dossier_version": {
      "type": "integer",
      "minimum": 1
    },
    "dossier_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environment": {
      "type": "string",
      "enum": ["lab", "sim-staging", "sim-prod-like"]
    },
    "alert_received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "window_end": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "dossier_ready_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "investigation_mode": {
      "type": "string",
      "enum": ["agentic_llm", "deterministic_baseline", "manual_fallback"]
    },
    "impact_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected_services", "observed_symptoms", "error_budget_impact"],
      "properties": {
        "affected_services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "observed_symptoms": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2048
        },
        "error_budget_impact": {
          "type": "string",
          "enum": ["severe", "moderate", "minor", "none_observed", "unknown"]
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "event_kind", "source_ref", "summary"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "event_kind": {
            "type": "string",
            "enum": ["alert", "metric_anomaly", "error_log", "trace_observation", "dependency_state", "workflow_event"]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "tool_name",
          "source_ref",
          "observed_at",
          "query_window",
          "data_quality",
          "truncated",
          "sanitized",
          "summary"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^ev-[A-Za-z0-9._-]+$"
          },
          "tool_name": {
            "type": "string",
            "enum": [
              "get_service_metrics",
              "search_error_logs",
              "get_trace_summary",
              "get_service_dependencies",
              "get_apm_health"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "query_window": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "end": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            }
          },
          "data_quality": {
            "type": "string",
            "enum": ["complete", "partial"]
          },
          "truncated": {
            "type": "boolean"
          },
          "sanitized": {
            "const": true
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "missing_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_name", "error_code", "recorded_at", "impact_note"],
        "properties": {
          "tool_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "error_code": {
            "type": "string",
            "enum": ["SOURCE_UNAVAILABLE", "BACKEND_TIMEOUT", "NO_APPLICABLE_RUNBOOK", "BUDGET_EXHAUSTED", "DEADLINE_EXCEEDED"]
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "impact_note": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "rank",
          "statement",
          "support_status",
          "supporting_evidence_ids",
          "contradicting_evidence_ids",
          "reason_summary",
          "unknowns"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "pattern": "^hyp-[A-Za-z0-9._-]+$"
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "statement": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2048
          },
          "support_status": {
            "type": "string",
            "enum": ["SUPPORTED", "PARTIAL", "INCONCLUSIVE"]
          },
          "supporting_evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ev-[A-Za-z0-9._-]+$"
            }
          },
          "contradicting_evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ev-[A-Za-z0-9._-]+$"
            }
          },
          "reason_summary": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2048
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 512
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "support_status": {
                  "const": "SUPPORTED"
                }
              }
            },
            "then": {
              "properties": {
                "supporting_evidence_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "sop_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "doc_id",
          "version",
          "section_path",
          "source_uri",
          "applicability_verified"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "minLength": 4,
            "maxLength": 128
          },
          "doc_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "section_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_uri": {
            "type": "string",
            "pattern": "^kb://[A-Za-z0-9._/-]+$"
          },
          "applicability_verified": {
            "const": true
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sanitized": {
            "const": true
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 512
      }
    },
    "recommended_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "description",
          "risk_level",
          "requires_human_approval",
          "auto_execution_allowed",
          "related_sop_doc_id"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1024
          },
          "risk_level": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "requires_human_approval": {
            "const": true
          },
          "auto_execution_allowed": {
            "const": false
          },
          "related_sop_doc_id": {
            "type": ["string", "null"],
            "maxLength": 128
          }
        }
      }
    },
    "review_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "latest_review_event_id", "reviewed_by", "reviewed_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING_REVIEW", "APPROVED", "REJECTED", "EDITED", "MANUAL_TRIAGE"]
        },
        "latest_review_event_id": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "reviewed_by": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_version",
        "policy_version",
        "model_version",
        "prompt_version",
        "tool_schema_version",
        "kb_index_version",
        "correlation_ids"
      ],
      "properties": {
        "workflow_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "tool_schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kb_index_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "correlation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 128
          }
        }
      }
    }
  }
}

